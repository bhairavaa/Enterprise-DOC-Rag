# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Postgres (document registry, auth, conversations, llama-index docstore)
# Host ports below are non-default (5435/6380/6335) because this machine
# already runs other projects' Postgres/Redis/Qdrant on the standard ports.
# Only host-side mappings differ; containers still talk to each other over
# the default ports inside the docker-compose network.
#
# Use 127.0.0.1, not localhost, in every host-side URL below. On Windows,
# resolving "localhost" tries ::1 (IPv6) first and times out before falling
# back to IPv4 -- a ~5-20s tax added to *every* new connection (Qdrant client
# construction, each fresh Postgres connection) when running the API/worker
# locally against dockerized infra. Inside Docker Compose this doesn't matter
# -- containers address each other by service name over the compose network,
# never through these host-side values (see the `&backend_env` anchor in
# docker-compose.yml, which overrides these for the api/worker containers).
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://rag_user:change_me@127.0.0.1:5435/enterprise_rag

# ---------------------------------------------------------------------------
# Redis (Celery broker/result backend)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380/0

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=enterprise_docs

# ---------------------------------------------------------------------------
# LLM provider (openai | anthropic | gemini | groq | openrouter)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# Applied explicitly to every provider -- each LlamaIndex LLM class has its
# own inconsistent implicit default otherwise (OpenRouter's is only 256
# tokens, easily truncating a multi-source cited answer mid-sentence).
LLM_MAX_TOKENS=2048

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Embedding provider (openai | gemini | huggingface)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Reranker (bge | cohere)
# Local BGE reranking loads a real cross-encoder model into memory. Set
# RERANKER_ENABLED=false for lightweight laptop/dev work — the rest of the
# pipeline works unaffected; enable it when actually evaluating retrieval
# quality.
# ---------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=5
COHERE_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
HYBRID_TOP_K=20
QUERY_REWRITE_ENABLED=true
NUM_QUERY_VARIATIONS=3
AUTO_MERGE_THRESHOLD=0.5

# Parent->child token sizes for hierarchical chunking, largest first. Only
# the smallest (leaf) size is embedded/searched; larger sizes are the
# "parent" context that AutoMergingRetriever assembles leaves back into.
CHUNK_SIZES=2048,512,128

UPLOAD_DIR=storage/uploads

# Rebuilt from scratch after every ingestion run (bm25s has no incremental
# update API).
BM25_INDEX_DIR=storage/bm25_index

# Context compression: keeps the top N% most query-relevant sentences per
# retrieved node, trimming prompt tokens without discarding whole chunks.
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_PERCENTILE_CUTOFF=0.5

# ---------------------------------------------------------------------------
# Semantic cache
# ---------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.96
SEMANTIC_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_API_KEY=change_me_admin_key

# ---------------------------------------------------------------------------
# Rate limiting (per API key, per endpoint -- /chat and /search tracked
# separately since they have different cost profiles)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
